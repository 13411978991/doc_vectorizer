{
  "name": "sag",
  "version": "0.1.0",
  "description": "SAG: event-centric retrieval with TypeScript, PostgreSQL/pgvector, HTTP and MCP interfaces.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "start": "node dist/src/index.js",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && npm run build:api && npm run build:web",
    "build:api": "tsc -p tsconfig.build.json",
    "build:web": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "lint": "eslint .",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:setup": "npm run db:migrate && npm run seed",
    "seed": "tsx src/db/seed.ts",
    "mcp": "SAG_LOG_STDERR=true tsx src/mcp/server.ts",
    "demo:ingest": "tsx scripts/demo-ingest.ts",
    "demo:search": "tsx scripts/demo-search.ts",
    "test": "vitest run",
    "test:pg": "vitest run",
    "build:sea-bundle": "node scripts/build-sea-bundle.mjs",
    "build:windows-exe": "node scripts/build-windows-exe.mjs",
    "build:windows": "npm run build && npm run build:sea-bundle && npm run build:windows-exe",
    "build:stdio-launcher": "node scripts/build-stdio-launcher.mjs",
    "build:stdio-launcher-exe": "node scripts/build-stdio-launcher-exe.mjs",
    "build:ingest-worker-launcher": "node scripts/build-ingest-worker-launcher.mjs",
    "build:ingest-worker-exe": "node scripts/build-ingest-worker-exe.mjs",
    "build:windows-all": "npm run build && npm run build:sea-bundle && npm run build:windows-exe && npm run build:stdio-launcher && npm run build:stdio-launcher-exe && npm run build:ingest-worker-launcher && npm run build:ingest-worker-exe"
  },
  "dependencies": {
    "@fastify/static": "^9.1.3",
    "@modelcontextprotocol/sdk": "^1.13.0",
    "@xenova/transformers": "^2.17.2",
    "@xyflow/react": "^12.11.0",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "gpt-tokenizer": "^3.4.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.17.0",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^6.1.200",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sqlite-vec": "^0.1.9",
    "tailwind-merge": "^3.6.0",
    "turndown": "^7.2.4",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.5",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^4.7.0",
    "@yao-pkg/pkg": "^6.21.0",
    "autoprefixer": "^10.5.0",
    "concurrently": "^10.0.3",
    "embedded-postgres": "^18.4.0-beta.17",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.62.1",
    "vite": "^5.4.10",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
