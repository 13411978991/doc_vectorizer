NODE_ENV=development
LOG_LEVEL=info
HTTP_HOST=0.0.0.0
HTTP_PORT=4173

# Database: SQLite file path (used by the zero-config .exe and local dev).
# For source checkouts that still run against PostgreSQL, set DATABASE_URL
# instead (see below). For the .exe, just leave this as-is or point it at
# a writable folder.
DATABASE_FILE=./data/sag.db
# DATABASE_URL=postgres://user:pass@localhost:5432/sag

DEFAULT_TENANT_ID=default
AUTH_MODE=none

# ─── Embedding ────────────────────────────────────────────────────────────────
# Configure exactly ONE of the three providers below.
#
# 1. "api" (default): calls a remote OpenAI-compatible endpoint.
#    Operator MUST set EMBEDDING_BASE_URL / EMBEDDING_MODEL /
#    EMBEDDING_API_KEY to point at a provider they have authorised.
#    Leaving any of them blank causes startup to fail loudly instead of
#    silently posting data to an unintended third party.
#
# 2. "local": offline SHA256 pseudo-embedding. Used only by tests;
#    do not enable in production — search quality is near-zero.
#
# 3. "local-bge": runs a Xenova/transformers BGE ONNX model locally.
#    No network, no Python. Set EMBEDDING_LOCAL_MODEL_PATH to the .onnx
#    directory; otherwise the model is auto-downloaded to the OS cache.
EMBEDDING_PROVIDER=api
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_LOCAL_MODEL_PATH=
EMBEDDING_TIMEOUT_MS=30000

# ─── LLM (event extraction / chat) ────────────────────────────────────────────
# Operator MUST set LLM_BASE_URL / LLM_MODEL / LLM_API_KEY. The shipped
# defaults are intentionally blank — a fresh install must not silently
# emit requests to a third-party endpoint.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_MS=60000
# LLM_MAX_RETRIES: how many times to retry a transient LLM/embedding
# failure. Default 0. With an invalid API key, retries multiply the
# per-file latency without changing the outcome. Keep 0 unless you
# have a flaky but valid endpoint and want some resilience.
LLM_MAX_RETRIES=0

# ─── Rerank ────────────────────────────────────────────────────────────────────
# Optional. Leave RERANK_BASE_URL blank to disable reranking.
RERANK_BASE_URL=
RERANK_MODEL=
RERANK_INSTRUCT=Given a user question, rank SAG event candidates by relevance and usefulness for retrieval-augmented question answering.

DEFAULT_SEARCH_MODE=fast

MCP_TRANSPORT=stdio
MCP_HTTP_PORT=4174
MCP_HTTP_PATH=/mcp
MCP_TOOL_TIMEOUT_MS=300000

# MCP HTTP transport auth (only consulted when MCP_TRANSPORT=http)
#   none    — open access, dev-only. Default.
#   bearer  — Authorization: Bearer <MCP_AUTH_TOKEN>
#   api_key — X-MCP-Key: <key>. CSV backend looks up MCP_API_KEYS (csv
#             ignore when MCP_API_KEY_BACKEND=db). DB backend looks up the
#             row in `mcp_api_keys` (POST /api/mcp/api-keys), supporting
#             create / revoke / label / per-key rate-limit overrides.
MCP_AUTH_MODE=none
MCP_AUTH_TOKEN=
MCP_API_KEYS=
MCP_API_KEY_BACKEND=csv
# MCP_API_KEY_CACHE_MAX=256   # LRU cache size for db lookups
MCP_RATE_LIMIT_RPM=120

# Persist MCP HTTP auth / rate-limit / session / tool-call events to
# SQLite audit_logs (action = http_auth_success|http_auth_denied|
# http_rate_limited|http_session_opened|http_session_closed|http_tool_call).
# Disable to skip the inserts in tightly constrained deployments.
MCP_AUDIT_LOG_ENABLED=true

# Source id binding for MCP tool calls. Tools sag_ingest_document /
# sag_search / sag_explain_search require SAG_MCP_SOURCE_ID to be a
# valid project UUID. Set MCP_REQUIRE_SOURCE_ID=false to relax (e.g. for
# HTTP deployments with multi-tenant inference inside the tool).
SAG_MCP_SOURCE_ID=
MCP_REQUIRE_SOURCE_ID=true


# Watcher (Sprint 1)
# Gates the local-folder watcher. In production, the watcher refuses to start
# unless this is explicitly set to `true` so deployed environments don't
# accidentally start syncing a stray /workspace or /tmp dir.
ALLOW_PROD_WATCHER=false
